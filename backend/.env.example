# Optional Groq API key for prompt judging
# Get a key from: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# Hugging Face token for image generation
# Use a fine-grained token with Inference Providers permission.
# https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_api_key_here

# Optional: Pollinations API key for authenticated image generation
# Keyless image generation is also supported.
# POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Server
PORT=5000
